# Required. Use the bot token, not a user token or client secret.
DISCORD_TOKEN=
TYPESAFE_API_KEY=

# Optional TypeSafe client settings.
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
# JSON client logs to stdout; off disables SDK logs, not bot request logs.
TYPESAFE_LOG_LEVEL=off

# Optional bot settings.
BOT_REQUEST_TIMEOUT=30s
BOT_MAX_CONCURRENT=4
BOT_MIN_CONFIDENCE=0.7
# At info/debug, bot logs include user text, Jev questions, and Discord IDs.
LOG_LEVEL=info
